{
  "name": "trustvault",
  "version": "1.0.0",
  "description": "TrustVault - Secure Document Sharing with a Real Cryptographic Audit Trail",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
